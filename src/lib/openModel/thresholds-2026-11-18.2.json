{
  "version": "2026-11-18.2",
  "track": "open",
  "description": "Open-track maintainability thresholds, derived from a public benchmark of Common Ground and Developer Overheid repositories with the benchmark method of Alves et al. Not a SIG rating.",
  "method": {
    "risk_thresholds": "Alves, Ypma and Visser 2010, section IV and Table IV: metric values at 70/80/90% (unit interfacing 80/90/95%) of the LOC-weighted unit distribution, every repository weighing the same",
    "star_limits": "Alves, Correia and Visser 2011, Algorithm 1 (section III-A), partition 5/30/30/30/5%; stars per section III-B1: the lowest of the per-share levels",
    "pooling": "all languages of a repository are pooled",
    "rounding": "star limits are rounded up to 4 decimals",
    "regenerate": "scripts/open-benchmark/README.md"
  },
  "distribution": {
    "5": 0.05,
    "4": 0.3,
    "3": 0.3,
    "2": 0.3,
    "1": 0.05
  },
