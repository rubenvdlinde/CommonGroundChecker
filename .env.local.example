# Optional: Add a GitHub Personal Access Token to raise the API rate limit
# from 60 to 5000 requests per hour (highly recommended for production use).
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: the number of organisations under usedBy in publiccode.yml a
# component needs to be Approved. The default of 2 is a proposal.
MIN_USERS=2
