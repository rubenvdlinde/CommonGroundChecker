#!/usr/bin/env python3
"""Stands in for `java -jar simian.jar` in tests: reports the first 8 lines of
the first two files as one clone set. FAKE_SIMIAN_VERSION sets the version in
the report, FAKE_SIMIAN_OOM=1 makes it run out of heap."""
import os
import sys

args = sys.argv[1:]
if os.environ.get("FAKE_SIMIAN_OOM") == "1":
    print('Exception in thread "main" java.lang.OutOfMemoryError: Java heap space', file=sys.stderr)
    sys.exit(1)
out = next(a.split(":", 1)[1] for a in args if a.startswith("-formatter=xml:"))
files = [a for a in args if os.path.isfile(a) and not a.endswith(".jar")]
version = os.environ.get("FAKE_SIMIAN_VERSION", "4.2.1")
blocks = "".join(f'<block sourceFile="{os.path.abspath(f)}" startLineNumber="1" endLineNumber="8"/>' for f in files[:2])
with open(out, "w") as fh:
    fh.write(f'<?xml version="1.0"?><simian version="{version}"><check threshold="6"><set lineCount="8">{blocks}</set></check></simian>')
