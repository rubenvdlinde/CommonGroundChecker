{
  "name": "common-ground-component-checker",
  "version": "0.0.2",
  "description": "Online compliance checker for Common Ground (Dutch municipalities architecture)",
  "license": "EUPL-1.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "generate:openapi": "openapi-typescript-codegen --input public/openapi.json --output src/generated/openapi-client --client fetch",
    "build": "next build",
    "start": "next start",
    "scan:local": "tsx scripts/scan-local.ts",
    "lint": "eslint . --ignore-pattern src/generated/** --ignore-pattern .next/** --ignore-pattern coverage/** --ignore-pattern badges/**",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:badge": "node scripts/update-coverage-badge.mjs",
    "security:badge": "node scripts/update-security-badge.mjs",
    "test:watch": "vitest",
    "security": "npm audit --audit-level=high",
    "security:secrets": "gitleaks git . --config .gitleaks.toml --redact"
  },
  "dependencies": {
    "@stoplight/spectral-cli": "6.17.0",
    "dotenv": "^17.4.1",
    "js-yaml": "^4.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.378.0",
    "next": "^16.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "jsdom": "^29.1.1",
    "openapi-typescript-codegen": "^0.30.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.4"
  }
}
