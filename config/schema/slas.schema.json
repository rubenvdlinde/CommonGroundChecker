{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SLAs of followed components",
  "description": "config/slas.yml: service level agreements on followed components.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slas"],
  "properties": {
    "slas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "party", "maintainer", "start", "until"],
        "properties": {
          "repository": { "type": "string", "pattern": "^https://\\S+$" },
          "party": { "description": "Who agreed the SLA, for example VNG.", "type": "string", "minLength": 1 },
          "maintainer": { "description": "The organisation that maintains the component under the SLA.", "type": "string", "minLength": 1 },
          "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "until": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "link": { "type": "string", "pattern": "^https?://\\S+$" }
        }
      }
    }
  }
}
