{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Component list of the Common Ground Checker",
  "description": "config/repositories.yml: the repositories the checker follows and scans every night.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repositories"],
  "properties": {
    "repositories": {
      "type": "array",
      "items": { "$ref": "#/definitions/repository" }
    }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "pattern": "^[^/].*" },
      "uniqueItems": true
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "description": "Public https URL of the repository on GitHub or GitLab.",
          "type": "string",
          "pattern": "^https://(github\\.com|gitlab\\.com|[a-z0-9.-]+)/[^\\s?#]+/[^\\s?#]+$"
        },
        "basisset": {
          "description": "Listed in the Common Ground basisset (code.overheid.nl/CommonGround/vcg-basisset).",
          "type": "boolean"
        },
        "scanRef": {
          "description": "What to scan: latest-release, default-branch, or a branch or tag name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "register": {
          "description": "The component is a register; its API specification is checked as one.",
          "type": "boolean"
        },
        "hints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "helm": { "$ref": "#/definitions/paths" },
            "docker": { "$ref": "#/definitions/paths" },
            "docs": { "$ref": "#/definitions/paths" },
            "apiSpecs": { "$ref": "#/definitions/paths" }
          }
        },
        "slaLabels": {
          "description": "Issue labels that mark an issue as covered by an SLA.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "retired": {
          "type": "object",
          "additionalProperties": false,
          "required": ["on", "reason"],
          "properties": {
            "on": { "$ref": "#/definitions/date" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        "providers": {
          "description": "Organisations that offer services on top of the component. Contracts and SLAs go in config/slas.yml.",
          "type": "array",
          "items": { "$ref": "#/definitions/provider" }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "services"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["maintenance", "support", "hosting", "implementation", "training"] }
        },
        "url": { "type": "string", "pattern": "^https?://\\S+$" },
        "contact": {
          "description": "A general address, such as info@example.nl or a contact page. No personal data.",
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "since": { "$ref": "#/definitions/date" }
      }
    }
  }
}
